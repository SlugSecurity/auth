IDENTITY_KANIDM_IMAGE=REPLACE_WITH_IMMUTABLE_IMAGE_ID
IDENTITY_PORTAL_IMAGE=REPLACE_WITH_IMMUTABLE_IMAGE_ID

IDENTITY_KANIDM_DATA_DIR=/var/lib/identity/kanidm
IDENTITY_PORTAL_STATE_DIR=/var/lib/identity/portal
IDENTITY_POSIX_STATE_DIR=/var/lib/identity/posix

IDENTITY_POSIX_STATUS_DIR=/var/lib/identity/status/posix
IDENTITY_BACKUP_STATUS_DIR=/var/lib/identity/status/backup

IDENTITY_METRICS_DASHBOARD_DIR=/var/lib/identity/metrics/dashboards
IDENTITY_MEMBER_DASHBOARD_DIR=/var/lib/identity/metrics/member-dashboards
IDENTITY_USAGE_EXPORT_DIR=/var/lib/identity/usage-export
IDENTITY_USAGE_STATE_DIR=/var/lib/identity/usage

IDENTITY_OPERATOR_SESSION_DIR=/var/lib/identity/operator-session
IDENTITY_CONFIG_DIR=/etc/identity
IDENTITY_PKI_DIR=/etc/identity/pki

IDENTITY_GOOGLE_CLIENT=/etc/identity/secrets/google-client.json
IDENTITY_OPERATOR_CREDENTIALS=/etc/identity/secrets/operator-credentials.json
IDENTITY_BACKEND_CA_KEY=/etc/identity/secrets/backend-ca.key

IDENTITY_TUNNEL_ID=REPLACE_WITH_TUNNEL_UUID
IDENTITY_TUNNEL_CREDENTIALS=/etc/identity/secrets/tunnel.json
