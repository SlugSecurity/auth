+
+    pub fn oauth2_consent_claims(
+        &mut self,
+        ident: &Identity,
+        client_id: &str,
+        scopes: &BTreeSet<String>,
+    ) -> Result<Option<String>, Oauth2Error> {
+        if !scopes.contains(OAUTH2_SCOPE_OPENID) {
+            return Ok(None);
+        }
+
+        let o2rs = self
+            .oauth2rs
+            .inner
+            .rs_set_get(client_id)
+            .ok_or(Oauth2Error::InvalidClientId)?;
+        let entry = ident
+            .get_user_entry()
+            .ok_or(Oauth2Error::ServerError(OperationError::InvalidState))?;
+        let account = Account::try_from_entry_ro(&entry, &mut self.qs_read)
+            .map_err(Oauth2Error::ServerError)?;
+
+        #[derive(Serialize)]
+        struct ConsentClaims {
+            #[serde(flatten)]
+            s_claims: OidcClaims,
+            #[serde(flatten)]
+            claims: BTreeMap<String, serde_json::Value>,
+        }
+
+        serde_json::to_string(&ConsentClaims {
+            s_claims: s_claims_for_account(o2rs, &account, scopes),
+            claims: extra_claims_for_account(&account, &o2rs.claim_map, scopes),
+        })
+        .map(Some)
+        .map_err(|_| Oauth2Error::ServerError(OperationError::SerdeJsonError))
     }
 
     #[instrument(level = "debug", skip_all)]
