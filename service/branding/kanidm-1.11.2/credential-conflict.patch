+#[derive(Clone, PartialEq)]
+struct CredentialUpdateBaseline {
+    account: BTreeMap<Attribute, Option<Cid>>,
+    policies: BTreeMap<Uuid, BTreeMap<Attribute, Option<Cid>>>,
+}
+
+fn credential_entry_snapshot(
+    entry: &EntrySealedCommitted,
+    attributes: &[Attribute],
+) -> Result<BTreeMap<Attribute, Option<Cid>>, OperationError> {
+    let crate::repl::entry::State::Live { changes, .. } = entry.get_changestate().current() else {
+        return Err(OperationError::InvalidEntryState);
+    };
+
+    Ok(attributes
+        .iter()
+        .map(|attribute| (attribute.clone(), changes.get(attribute).cloned())) // native attribute versions include counter updates ignored by credential equality
+        .collect())
+}
+
 impl IdmServerProxyWriteTransaction<'_> {
+    fn credential_update_baseline(
+        &mut self,
+        target: Uuid,
+    ) -> Result<CredentialUpdateBaseline, OperationError> {
+        let entry = self.qs_write.internal_search_uuid(target)?;
+        let account = credential_entry_snapshot(
+            entry.as_ref(),
+            &[
+                Attribute::Class,
+                Attribute::MemberOf,
+                Attribute::AccountExpire,
+                Attribute::AccountValidFrom,
+                Attribute::PrimaryCredential,
+                Attribute::UnixPassword,
+                Attribute::SshPublicKey,
+                Attribute::PassKeys,
+                Attribute::AttestedPasskeys,
+            ],
+        )?;
+        let mut policies = BTreeMap::new();
+
+        if let Some(groups) = entry.get_ava_as_refuuid(Attribute::MemberOf) {
+            for group in groups {
+                let policy_entry = self.qs_write.internal_search_uuid(group)?;
+                policies.insert(
+                    group,
+                    credential_entry_snapshot(
+                        policy_entry.as_ref(),
+                        &[
+                            Attribute::Class,
+                            Attribute::AuthSessionExpiry,
+                            Attribute::PrivilegeExpiry,
+                            Attribute::AuthPasswordMinimumLength,
+                            Attribute::CredentialTypeMinimum,
+                            Attribute::WebauthnAttestationCaList,
+                            Attribute::LimitSearchMaxResults,
+                            Attribute::LimitSearchMaxFilterTest,
+                            Attribute::AllowPrimaryCredFallback,
+                        ],
+                    )?,
+                );
+            }
+        }
+        Ok(CredentialUpdateBaseline { account, policies })
+    }
